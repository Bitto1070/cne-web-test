---
import '../styles/code.css';
import Page from '../components/Page.astro';
import poop from '../wiki.json';

const { frontmatter } = Astro.props;

// WORST SHIT IVE EVER done
function stupid(b:Array<any>, root:string):string {
    var url = Astro.url.pathname;
    if (!url.endsWith('/')) url += '/';
    return `<div>
        <a href=${'/wiki/'+root+b[0]} style="text-decoration: none;">
            <button style="width: 100%; text-align: left; justify-content: left; margin: 0px; display: block; border-radius: 8px; font-weight: bolder;"
            class=${((url == ('/wiki/'+root+b[0])) || (url == ('/wiki/'+root+b[0]+'/'))) ? '' : 'col-black'}>
                ${b[1]}
            </button>
        </a>
        ${(b[2] != undefined) ? 
            `<div style="margin-left: 0.5em;
            padding-left: 0.5em;
            border-left: 2px solid var(--primary-color);">
                ${b[2].map((c:any) => (stupid(c, root + b[0] + '/'))).join('\n')}
            </div>`
         : ''}
    </div>`
}
---

<Page title={frontmatter.title}>
    <div class="no-phantommuff" style="display: grid; grid-template-columns: 0.5fr 1.5fr; gap: 12px; width: 100%;">
        <div class="subpanel" style="display: flex; padding: 3px; flex-direction: column; overflow-y: auto; height: calc(100vh - 64px - 36px); position: sticky; top: calc(64px + 12px);">
            {
                poop.map((b:any) => (
                    <Fragment set:html={stupid(b, '')} />
                ))
            }
        </div>
        <div class="panel " x-data={`{lastUpdated: new Date("${frontmatter.lastUpdated}")}`} style="overflow-y: auto; padding: 32px; padding-top: 0;">
            <slot/>
            <hr/>
            <div class="phantommuff" style="display: flex; justify-content: space-between; align-items: center;">
                <b style="opacity: 50%; font-weight: 100;">
                    Written by {frontmatter.author} &bull;
                    <span x-html="getRelativeTimeString(lastUpdated)" title={new Date(frontmatter.lastUpdated).toDateString()} />
                </b>
                <a href="https://deltarune.com/lancer/">Edit on GitHub</a>
            </div>

            <!--
                add comment box here later
            -->
        </div>
    </div>
</Page>