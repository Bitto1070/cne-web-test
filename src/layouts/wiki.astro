---
import '../styles/code.css';
import Page from '../components/Page.astro';
import poop from '../wiki.json';

const { frontmatter, id } = Astro.props;

// WORST SHIT IVE EVER done
function stupid(b:Array<any>, root:string):string {
    if (b == null) return '<hr style="display: flex; width: 90%;"/>';
    var subpages = (b[2] != undefined) ? `<div style="margin-left: 0.5em;
            padding-left: 0.5em;
            border-left: 2px solid var(--primary-color);">
                ${b[2].map((c:any) => (stupid(c, root + b[0] + '/'))).join('\n')}
            </div>` : '';
    // b[3] being true means its unclickable, but still has subpages
    if (b[3] == true) return `
    <div x-data="{show:true}">
        <div class="panel" style="border-radius: 8px; font-weight: bolder; padding: 8px; margin: 2px; display: flex; align-items: center; justify-content: space-between;">
            ${b[1]} <img src="${(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/pixel/menu.png"}" alt="Show/Hide" title="Show/Hide" width="16" height="16" x-on:click="show = !show" style="image-rendering: pixelated; cursor: pointer;"/>
        </div>
        <div x-show="show">
            ${subpages}
        </div>
    </div>`;
    var url = Astro.url.pathname;
    if (!url.endsWith('/')) url += '/';
    const coolRoot = (import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+'wiki/'+root+b[0];
    return `<div>
        <a href=${coolRoot+'/'} style="text-decoration: none;">
            <button style="width: 100%; text-align: left; justify-content: left; margin: 0px; display: block; border-radius: 8px; font-weight: bolder;"
            class=${((url == coolRoot) || (url == (coolRoot+'/'))) ? '' : 'col-black'}>
                ${b[1]}
            </button>
        </a>
        ${subpages}
    </div>`
}
---

<Page title={frontmatter.title} desc={frontmatter.desc}>
    <div class="no-phantommuff" style="display: grid; grid-template-columns: 0.5fr 1.5fr; gap: 12px; width: 100%;">
        <div class="subpanel" style="display: flex; padding: 3px; flex-direction: column; overflow-y: auto; height: calc(100vh - 64px - 36px); position: sticky; top: calc(64px + 12px);">
            {
                poop.map((b:any) => (
                    <Fragment set:html={stupid(b, '')} />
                ))
            }
        </div>
        <div class="panel " x-data={`{lastUpdated: new Date("${frontmatter.lastUpdated}")}`} style="overflow-y: auto; padding: 32px; padding-top: 0;">
            <slot/>
            <hr/>
            <div class="phantommuff" style="display: flex; justify-content: space-between; align-items: center;">
                <b style="opacity: 50%; font-weight: 100;">
                    Written by {frontmatter.author} &bull;
                    <span x-html="getRelativeTimeString(lastUpdated)" title={new Date(frontmatter.lastUpdated).toDateString()} />
                </b>
                <a href={"https://github.com/CodenameCrew/cne-web-test/tree/main/wiki/" + id}>Edit on GitHub</a>
            </div>
            <br/>
            <div class="giscus"></div>
			<div class="giscus-frame"></div>

			<script src="https://giscus.app/client.js"
				data-repo="CodenameCrew/codename-website"
				data-repo-id="R_kgDOMm2E8w"
				data-category="Website"
				data-category-id="DIC_kwDOMm2E884Cio1F"
				data-mapping="specific"
				data-term="{{ giscusID }}"
				data-strict="0"
				data-reactions-enabled="0"
				data-emit-metadata="0"
				data-input-position="top"
				data-theme="https://codename-engine.com/giscus-theme.css"
				data-lang="en"
				data-loading="lazy"
				crossorigin="anonymous"
				async>
			</script>
        </div>
    </div>
</Page>