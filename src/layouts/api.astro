---
import '../styles/code.css';
import Page from '../components/Page.astro';

interface Props {
    title?: string
}

const { title } = Astro.props;
---

<Page title={title}>
    <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 12px; width: 100%; align-items: start;">
        <div class="subpanel" style="display: flex; padding: 3px; flex-direction: column; overflow-y: auto; height: calc(100vh - 64px - 36px); position: sticky; top: calc(64px + 12px);">
            <input type="text" placeholder="Search..."/>
            <hr style="display: flex; height: 0px; width: 100%;"/>
            search goes here
            (ADD THE STUFF LATER)
        </div>
        <div class="panel">
            <slot/>
        </div>
    </div>
</Page>