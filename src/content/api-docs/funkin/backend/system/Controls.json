			"ret": "Void",
			"isStatic": false,
			"isInline": false,
			"src": "public function new(name, scheme = None)\r\n\t{\r\n\t\tsuper(name);\r\n\r\n\t\tmacro_addKeysToActions();\r\n\r\n\t\tfor (action in digitalActions)\r\n\t\t\tbyName[action.name] = action;\r\n\r\n\t\tsetKeyboardScheme(scheme, false);\r\n\t}",
			"doc": null,
			"meta": []
		},
