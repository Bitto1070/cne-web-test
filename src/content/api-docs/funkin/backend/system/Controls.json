			"src": "public function getActionFromControl(control:Control):FlxAction return macro_getActionFromControl(control);",
			"doc": null,
			"meta": []
		},
		{
			"kind": "function",
			"name": "getKeyName",
			"args": [
				{
					"name": "control",
					"type": "Control",
					"optional": false,
					"def": null
				},
				{
					"name": "idx",
					"type": "Int",
					"optional": false,
					"def": "0"
				}
			],
			"ret": "String",
			"isStatic": false,
			"isInline": false,
			"src": "public function getKeyName(control:Control, idx:Int = 0):String\r\n\t{\r\n\t\tvar action = macro_getActionFromControl(control);\r\n\t\tvar input = action.inputs[idx];\r\n\t\treturn switch input.device\r\n\t\t{\r\n\t\t\tcase KEYBOARD: return '${(input.inputID : FlxKey)}';\r\n\t\t\tcase GAMEPAD: return '${(input.inputID : FlxGamepadInputID)}';\r\n\t\t\tcase device: throw 'unhandled device: $device';\r\n\t\t}\r\n\t}",
			"doc": null,
			"meta": []
		},
