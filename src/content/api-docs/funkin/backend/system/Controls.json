			],
			"ret": "Void",
			"isStatic": false,
			"isInline": false,
			"src": "public function replaceBindingKeyboard(control:Control, ?toAdd:Int, ?toRemove:Int)\r\n\t{\r\n\t\tif (toAdd == toRemove)\r\n\t\t\treturn;\r\n\r\n\t\tif (toRemove != null)\r\n\t\t\tunbindKeys(control, [toRemove]);\r\n\t\tif (toAdd != null)\r\n\t\t\tbindKeys(control, [toAdd]);\r\n\t}",
			"doc": null,
