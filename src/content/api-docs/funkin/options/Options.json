			"isStatic": true,
			"isInline": false,
			"src": "public static function applyQuality() {\r\n\t\tswitch (quality) {\r\n\t\t\tcase 0:\r\n\t\t\t\tantialiasing = false;\r\n\t\t\t\tlowMemoryMode = true;\r\n\t\t\t\tgameplayShaders = false;\r\n\t\t\tcase 1:\r\n\t\t\t\tantialiasing = true;\r\n\t\t\t\tlowMemoryMode = false;\r\n\t\t\t\tgameplayShaders = true;\r\n\t\t}\r\n\r\n\t\tFlxG.game.stage.quality = (FlxG.enableAntialiasing = antialiasing) ? BEST : LOW;\r\n\t}",
			"doc": null,
