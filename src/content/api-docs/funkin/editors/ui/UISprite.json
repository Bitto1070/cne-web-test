			"isStatic": false,
			"isInline": false,
			"src": "public function drawSuper() {\r\n\t\tsuper.draw();\r\n\t\t__lastDrawCameras = cameras.copy();\r\n\t}",
			"doc": null,
			"meta": []
		},
		{
			"kind": "function",
			"name": "drawMembers",
			"args": [],
			"ret": "Void",
			"isStatic": false,
			"isInline": false,
			"src": "public function drawMembers() {\r\n\t\t@:privateAccess {\r\n\t\t\t__oldDefCams = FlxCamera._defaultCameras;\r\n\t\t\tFlxCamera._defaultCameras = cameras;\r\n\r\n\t\t\tfor(m in members)\r\n\t\t\t\tif(m.exists && m.visible)\r\n\t\t\t\t\tm.draw();\r\n\r\n\t\t\tFlxCamera._defaultCameras = __oldDefCams;\r\n\t\t}\r\n\t}",
			"doc": null,
