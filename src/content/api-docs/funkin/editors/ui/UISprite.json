			"isStatic": false,
			"isInline": false,
			"src": "public function updateButtonHandler() {\r\n\t\tUIState.state.updateButtonHandler(this, onHovered);\r\n\t}",
			"doc": null,
			"meta": []
		},
		{
			"kind": "function",
			"name": "onHovered",
			"args": [],
			"ret": "Void",
			"isStatic": false,
			"isInline": false,
			"src": "public function onHovered() {\r\n\t\thovered = true;\r\n\t\tif (FlxG.mouse.pressed)\r\n\t\t\tpressed = true;\r\n\t\tif (hoverCallback != null)\r\n\t\t\thoverCallback();\r\n\t}",
