		{
			"kind": "function",
			"name": "updateButton",
			"args": [],
			"ret": "Void",
			"isStatic": false,
			"isInline": false,
			"src": "public function updateButton() {\r\n\t\tif(canBeHovered)\r\n\t\t\tupdateButtonHandler();\r\n\t\telse {\r\n\t\t\tif(FlxG.mouse.pressed) {\r\n\t\t\t\tupdateButtonHandler();\r\n\t\t\t}\r\n\t\t}\r\n\t}",
			"doc": null,
