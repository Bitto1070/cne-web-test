			"isInline": false,
			"src": "public override function new(x:Float, y:Float, text:String, callback:Void->Void, w:Int = 120, h:Int = 32) {\r\n\t\tsuper(x, y, w, h, 'editors/ui/button');\r\n\t\tthis.callback = callback;\r\n\t\tif(text != null) {\r\n\t\t\tmembers.push(field = new UIText(x, y, w, text));\r\n\t\t\tfield.alignment = CENTER;\r\n\t\t\tfield.fieldWidth = w;\r\n\t\t}\r\n\r\n\t\tcursor = CLICK;\r\n\t}",
