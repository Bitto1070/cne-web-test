---
import Page from '../components/Page.astro';
---
<Page title="Tools" desc="A variety of tools to help with mod development.">
    <div class="panel" style="text-align: center; width: fit-content; margin: auto;">
        <div class="phantommuff">
            <h1>Tools</h1>
            A variety of tools to help with mod development.
            <br/><br/>
            <span style="font-size: 1.3em; color: #f33;">
                none of the in-site tools work yet cus<br/>
                there is no functionality added to them yet
            </span>
        </div>
        <hr/>
        <div style="width: 50vw; display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            {
                [
                    {
                        name: 'Event Packer',
                        desc: 'Pack event files into a single <code>.pack</code> file',
                        url: 'event-packer/'
                    },
                    {
                        name: 'Texture Packer',
                        desc: 'Optimize or repack spritesheets',
                        url: 'https://kitzsh.github.io/tex-packer-ex/'
                    },
                    {
                        name: 'Video Compressor',
                        desc: 'Compress videos to reduce their size <b style="font-size: 0.7em;">(Warning: this is not a lossless compression)</b>',
                        url: 'https://tools.rotato.app/compress/'
                    },
                    {
                        name: 'Psych Character Converter',
                        desc: 'Converts a Psych Engine character JSON to a Codename character XML',
                        url: 'psych-char-converter/'
                    }
                ].map((a) => (
                    <a href={(a.url.startsWith('http')?import.meta.env.BASE_URL:'')+a.url} style="text-decoration: none;">
                    <div class="subpanel"
                    style="
                    border: 2px solid #fff3; text-align: left; color: var(--text-color);
                    ">
                        {
                            (a.url.startsWith('http')) && (
                                <img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/icons/external.svg"} width="20" style="float: right;"/>
                            )
                        }
                        <h3 style="margin-top: 0;">{a.name}</h3>
                        <p style="margin: 0;" set:html={a.desc}/>
                    </div>
                    </a>
                ))
            }
        </div>
    </div>
</Page>