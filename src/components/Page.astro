---
import '../styles/global.css';
interface Props {
	title?: string;
	desc?: string;
	noFooter?: boolean;
}

const { title = 'Home', desc = 'cod name', noFooter = false } = Astro.props;
---

<!-- blehhh -->
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/favicon.svg"} />
		<title>{title} - Codename Engine</title>

		<meta name="title" 				content={title + ' - Codename Engine'} />
		<meta property="og:title" 		content={title + ' - Codename Engine'} />
		<meta property="twitter:title"  content={title + ' - Codename Engine'} />

		<meta name="description" 			 content={desc} />
		<meta property="og:description" 	 content={desc} />
		<meta property="twitter:description" content={desc}/ >

		<meta property="og:url" 	 content={import.meta.env.SITE} />
		<meta property="twitter:url" content={import.meta.env.SITE} />

		<meta property="og:type" 		content="website" />
		<meta property="og:image" 		content={import.meta.env.SITE + "/img/banner.png"}/>
		<meta property="twitter:image"  content={import.meta.env.SITE + "/img/banner.png"}/>
		<meta property="twitter:card"   content="summary_large_image" />

		<meta name="keywords" content="codename engine, codename, engine, game, modding, mods, website, documentation, wiki, tools, tool, codenameengine, cne, funkin, fnf, fnf engine, fnf engines, friday night funkin, gamebanana fnf" />

		<meta name="theme-color" content="#b265bd">

        <style is:global>
            .desktop {
                display: inline;
            }
            .mobile {
                display: none;
            }

            @media screen and (max-width: 1000px) {
                .desktop {
                    display: none !important;
                }
                .mobile {
                    display: inherit;
                }
            }
        </style>
		<script is:inline>
			function getRelativeTimeString(date) {
				var timeMs = typeof date === "number" ? date : date.getTime();
				var deltaSeconds = Math.round((timeMs - Date.now()) / 1000);
				var cutoffs = [60, 3600, 86400, 86400 * 7, 86400 * 30, 86400 * 365, Infinity];
				var units = ["second", "minute", "hour", "day", "week", "month", "year"];
				var unitIndex = cutoffs.findIndex(cutoff => cutoff > Math.abs(deltaSeconds));
				var divisor = unitIndex ? cutoffs[unitIndex - 1] : 1;
				var rtf = new Intl.RelativeTimeFormat('en', { numeric: "auto" });
				return rtf.format(Math.floor(deltaSeconds / divisor), units[unitIndex]);
			}
		</script>
	</head>
	<body>
		<header>
			<a href={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"index"}>
				<img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/logo-banner.png"} alt="Codename Engine" width="250" class="desktop" />
            	<img src={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+"img/logo-banner-mini.png"} alt="Codename Engine" width="100" class="mobile" />
			</a>
			<b style="font-size: 1.3em;">{title}</b>
			<div style="display: flex;">
			{
				[
					{name: 'API', url: 'api-docs/'},
					{name: 'Wiki', url: 'wiki/index/'},
					{name: 'Tools', url: 'tools/'}
				].map((a) => (
					<a href={(import.meta.env.DEV?'':import.meta.env.BASE_URL)+'/'+a.url} style="text-decoration: none; margin-top: 0.1em; margin-bottom: 0.1em;">
						<button class="col-black">{a.name}</button>
					</a>
				))
			}
			</div>
		</header>
		<div style="margin: 12px; flex-grow: 1; display: flex; align-items: center;">
            <slot/>
		</div>
		{
			!noFooter && (<footer>
				<div class="phantommuff" style="display: flex; align-items: center; justify-content: center;">
					{
						[
							{name: 'Home', url: 'index'},
							{name: 'API', url: 'api-docs/'},
							{name: 'Wiki', url: 'wiki/index/'},
							{name: 'Tools', url: 'tools/'},
							{name: 'Contribute', url: 'https://github.com/CodenameCrew/cne-web-test/'}
						].map((a) => (
							<a href={(a.url.startsWith('http')?'':(import.meta.env.DEV?'':(import.meta.env.BASE_URL+'/')))+a.url} style="text-decoration: none;">
								<button>{a.name}</button>
							</a>
						))
					}
					<div style="width: 100px; text-align: center;">&bull;</div>
					☻ Codename Crew
					<br/>
					{
						[
							['github', 'https://github.com/CodenameCrew/'],
							['gamebanana', 'https://deltarune.com/lancer'],
							['itch', 'https://deltarune.com/lancer'],
							['discord', 'https://discord.gg/codename-crew'],
							['twitter', 'https://deltarune.com/lancer'],
							['bluesky', 'https://deltarune.com/lancer'],
							['youtube', 'https://deltarune.com/lancer'],
							
						].map((a) => (
							<a href={a[1]} style="text-decoration: none;">
								<button style="margin: 3px;">
									<img src={(import.meta.env.DEV?'':(import.meta.env.DEV?'':import.meta.env.BASE_URL))+'/'+"img/icons/" + a[0] + ".svg"} height="16"/>
								</button>
							</a>
						))
					}
				</div>
			</footer>)
		}
	</body>
</html>
